<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/notesFragment">

    <fragment android:id="@+id/notesFragment"
        android:name="com.zainab.notely.ui.notes.NotesFragment"
        android:label="Notes">
        <action
            android:id="@+id/action_notes_to_addNote"
            app:destination="@id/addNoteFragment" />
        <action
            android:id="@+id/action_notes_to_noteDetail"
            app:destination="@id/noteDetailFragment" />
    </fragment>

    <fragment android:id="@+id/noteDetailFragment"
        android:name="com.zainab.notely.ui.notes.NoteDetailFragment"
        android:label="Note">
        <argument
            android:name="noteId"
            app:argType="integer" />
        <action
            android:id="@+id/action_noteDetail_to_addNote"
            app:destination="@id/addNoteFragment" />
    </fragment>

    <fragment android:id="@+id/addNoteFragment"
        android:name="com.zainab.notely.ui.notes.AddNoteFragment"
        android:label="Add note">
        <argument
            android:name="noteId"
            app:argType="integer"
            android:defaultValue="-1" />
    </fragment>
</navigation>